{
  "manifest_version": 3,
  "name": "HH Авто-отклик Pro",
  "version": "2.4",
  "minimum_chrome_version": "111",
  "description": "Авто-отклик HH.ru с максимальной WASM защитой",
  "permissions": [
    "activeTab",
    "storage",
    "declarativeNetRequest",
    "scripting",
    "tabs",
    "notifications"
  ],
  "host_permissions": [
    "*://*.hh.ru/*",
    "*://hh.ru/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.hh.ru/*",
        "*://hh.ru/*"
      ],
      "js": [
        "hh-protect.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false
    },
    {
      "matches": [
        "*://*.hh.ru/*",
        "*://hh.ru/*"
      ],
      "js": [
        "protect.js",
        "core.js",
        "ui.js",
        "content.js"
      ],
      "run_at": "document_start",
      "world": "ISOLATED",
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "protect.wasm"
      ],
      "matches": [
        "*://*.hh.ru/*",
        "*://hh.ru/*"
      ]
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "ruleset_1",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  },
  "optional_permissions": [
    "declarativeNetRequestFeedback"
  ]
}